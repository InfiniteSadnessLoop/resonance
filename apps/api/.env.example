NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/resonance?schema=public
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
SPOTIFY_CLIENT_ID=replace_with_your_spotify_client_id
SPOTIFY_CLIENT_SECRET=replace_with_your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/spotify/callback
SPOTIFY_TOKEN_ENCRYPTION_KEY=replace_with_64_random_hex_characters
