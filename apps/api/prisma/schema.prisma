
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  displayName String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
